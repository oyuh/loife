# Base URL of this deployment, no trailing slash.
# Local: http://localhost:3000   Railway: https://your_app_name_here.up.railway.app
PUBLIC_URL=http://localhost:3000

# GitHub OAuth app credentials, from https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Numeric GitHub account ID allowed to sign in. Not the username, which can be
# changed and then claimed by someone else.
# Find yours: curl -s https://api.github.com/users/your_github_username_here
ALLOWED_GITHUB_ID=1234567890123

# At least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=your_session_secret_here

# Postgres. Railway injects this when you add the Postgres plugin; copy the
# public connection string here for local drizzle-kit runs.
DATABASE_URL=postgresql://user:password@host:5432/railway

# Google OAuth client (Web application) from console.cloud.google.com with the
# Google Calendar API enabled. Authorised redirect URI must be exactly:
#   https://your_domain_here/api/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Day boundaries come from the host timezone. Without this a UTC container
# files an 11pm assignment under tomorrow.
TZ=America/Chicago

# Cloudflare R2, from a private bucket's S3 API token.
# Account ID is in the R2 dashboard URL.
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_here
R2_SECRET_ACCESS_KEY=your_r2_secret_here
R2_BUCKET=loife
