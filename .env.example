####################################################################
# loife environment
#
# Copy to .env and fill in. .env is gitignored, so nothing here
# reaches the repo.
#
#   cp .env.example .env
#
# The first block is required. The app will not boot without it.
# The two blocks after it turn on optional features, and the app
# runs fine with them blank.
####################################################################


####################################################################
# REQUIRED
####################################################################

# ---------------------------------------------------------------
# PUBLIC_URL
# Where this deployment answers, with no trailing slash.
#
# Both OAuth redirect URIs are built from it, so a wrong value here
# breaks sign in with a redirect_uri_mismatch rather than anything
# that names the real cause.
#
#   local     http://localhost:3000
#   deployed  https://your_domain_here
# ---------------------------------------------------------------
PUBLIC_URL=http://localhost:3000


# ---------------------------------------------------------------
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
# The GitHub OAuth app you sign in through.
#
# Create one at https://github.com/settings/developers
#   1. OAuth Apps, then New OAuth App
#   2. Application name:        anything
#   3. Homepage URL:            your PUBLIC_URL
#   4. Authorization callback:  PUBLIC_URL + /api/auth/callback
#      local: http://localhost:3000/api/auth/callback
#   5. Register, then Generate a new client secret
#
# The secret is shown once. Copy it before leaving the page.
#
# An OAuth app holds ONE callback URL, so make a second app for
# local work and give each environment its own pair below.
# ---------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here


# ---------------------------------------------------------------
# ALLOWED_GITHUB_ID
# The one GitHub account allowed in. Everyone else gets a 403.
#
# Find yours, swapping in your username:
#   curl -s https://api.github.com/users/your_github_username_here
# and copy the "id" field. It is a number, not your username.
#
# The numeric ID is used because GitHub lets a username be changed
# and then claimed by someone else. The ID never moves.
# ---------------------------------------------------------------
ALLOWED_GITHUB_ID=1234567890123


# ---------------------------------------------------------------
# SESSION_SECRET
# Encrypts and signs the session cookie. 32 characters minimum.
#
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Use a different value in each environment. Changing it signs
# everyone out, which is also how you revoke a leaked cookie.
# ---------------------------------------------------------------
SESSION_SECRET=your_session_secret_here


# ---------------------------------------------------------------
# DATABASE_URL
# Postgres 16 or newer. Any host works.
#
#   postgresql://user:password@host:5432/database
#
# Where to get one, all with a free tier:
#   Neon      https://neon.tech          serverless, scales to zero
#   Supabase  https://supabase.com       Postgres plus a dashboard
#   Railway   add the Postgres plugin and it injects this for you
#
# Hosted providers usually want SSL. If the connection is refused,
# append ?sslmode=require to the string.
#
# For local Docker Postgres, run `pnpm local:dev` instead. It
# passes its own connection string through the environment and
# never reads this file, so a dev session cannot touch your real
# database.
# ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database


# ---------------------------------------------------------------
# TZ
# Your IANA time zone. Day boundaries come from it, so without
# this a UTC container files an 11pm assignment under tomorrow.
#
# Full list:
#   https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
#
# Must match DISPLAY_TIME_ZONE in src/lib/datetime.ts, which is
# the client-side half. If the two disagree, a server-rendered
# page flips its dates on hydration.
# ---------------------------------------------------------------
TZ=America/Chicago


####################################################################
# OPTIONAL: Google Calendar sync
#
# Leave blank to run without it. The courses page then shows a
# "not connected" notice and no due dates leave the app.
####################################################################

# ---------------------------------------------------------------
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# Writes due dates to a dedicated Google calendar named "loife",
# never your primary one. Notion Calendar and Apple Calendar both
# read Google, so the events show up wherever you already look.
#
# At https://console.cloud.google.com
#   1. Create a project, or pick one
#   2. APIs & Services, Library, enable "Google Calendar API"
#   3. APIs & Services, OAuth consent screen, choose External,
#      and add your own Google address under Test users
#   4. Credentials, Create Credentials, OAuth client ID,
#      Application type "Web application"
#   5. Authorised redirect URI, exactly:
#      PUBLIC_URL + /api/google/callback
#      local: http://localhost:3000/api/google/callback
#
# Worth knowing: while the consent screen sits in Testing, Google
# expires the refresh token after 7 days and you have to reconnect.
# Publish the app to stop that.
#
# The app asks for the full calendar scope. Google has no narrower
# one that can create a calendar, so that is the floor.
#
#   ID looks like  1234567890123-abc123.apps.googleusercontent.com
#   Secret starts  GOCSPX-
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here


####################################################################
# OPTIONAL: file attachments
#
# Leave blank to run without them. Everything else keeps working.
# Any S3 compatible bucket does, not only Cloudflare.
####################################################################

# ---------------------------------------------------------------
# R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET
# Cloudflare R2 through the S3 API. The free tier covers 10 GB and
# charges nothing for egress.
#
# At https://dash.cloudflare.com
#   1. R2, Create bucket. Keep it private
#   2. Copy the Account ID from the R2 overview page
#   3. Manage R2 API Tokens, Create API token
#   4. Permission "Object Read & Write", scoped to that bucket
#   5. Copy the Access Key ID and Secret Access Key, shown once
#
# CORS matters here. The browser uploads straight to the bucket
# with a presigned PUT, so add a CORS rule on the bucket allowing
# PUT and GET from your PUBLIC_URL. Without it uploads fail in the
# browser while the server-side code looks fine.
#
# The cap is 100 MB per file, set in src/lib/upload-limits.ts.
#
# Alternatives that speak the same API: Backblaze B2, Wasabi, or a
# MinIO container you host. Point R2_ENDPOINT at those.
# ---------------------------------------------------------------
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET=loife

# ---------------------------------------------------------------
# R2_ENDPOINT
# Leave unset for Cloudflare, which is derived from R2_ACCOUNT_ID.
#
# Set it only to point at a different S3 provider. `pnpm local:dev`
# already sets it to the local MinIO container, so dev uploads
# never reach the real bucket.
# ---------------------------------------------------------------
# R2_ENDPOINT=https://s3.your_provider_here.com
